# Copy to .env. Every key is optional: without it the bot runs in mock mode.
FRONTDESK_DB=data/frontdesk.db
# WhatsApp Cloud API (concierge)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me
# Chatwoot (concierge handoff)
CHATWOOT_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
# Optional LLM hook for triage (OpenAI-compatible endpoint)
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
# Scout data sources
COMPANIES_HOUSE_API_KEY=
DEVPOST_ENABLED=0
# Twenty CRM
TWENTY_API_URL=
TWENTY_API_KEY=
# Supabase (optional, SQLite used otherwise)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
